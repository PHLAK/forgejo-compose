# ------------------------------------------------------------------------------
# Forgejo version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# FORGEJO_VERSION=latest

# ------------------------------------------------------------------------------
# Container port bindings exposed to the host.
# ------------------------------------------------------------------------------

# FORGEJO_WEB_PORT=3000
# FORGEJO_SSH_PORT=22

# ------------------------------------------------------------------------------
# Path to the Forgejo data directory on the host file system. This may be an
# absolute path or a path relative to the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

FORGEJO_DATA_PATH=./volumes/forgejo

# ------------------------------------------------------------------------------
# Volume where database data will be stored. Path may be absolute or relative to
# the 'docker-compose.yaml' file. If left unset, database data will be stored in
# a Docker volume named 'postgres-data'.
# ------------------------------------------------------------------------------

# DATABASE_VOLUME=postgres-data

# ------------------------------------------------------------------------------
# The database configuration used for database container storage. Only the
# password is required when using the provided 'postgres' container.
# ------------------------------------------------------------------------------

# DATABASE_HOST=database
# DATABASE_PORT=5432
# DATABASE_USER=forgejo
DATABASE_PASSWORD=

# ------------------------------------------------------------------------------
# Modifies privileges within the container to match this host user and group ID.
# ------------------------------------------------------------------------------

HOST_UID=
HOST_GID=
